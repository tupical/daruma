{
  "name": "daruma-claude",
  "version": "0.3.1",
  "description": "Glue between tupical/daruma and oh-my-claudecode. Ships task workflows, SessionStart/Stop hooks and a managed CLAUDE.md tracker policy.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "daruma",
    "daruma",
    "oh-my-claudecode",
    "orchestration",
    "multi-agent",
    "agent",
    "plugin"
  ],
  "homepage": "https://github.com/tupical/daruma/tree/main/clients/claude-plugin#readme",
  "bugs": {
    "url": "https://github.com/tupical/daruma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupical/daruma.git",
    "directory": "clients/claude-plugin"
  },
  "author": "tupical",
  "license": "MIT",
  "type": "module",
  "bin": {
    "daruma-claude": "bin/daruma-claude.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "commands/",
    "skills/",
    "hooks/",
    ".claude-plugin/",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "version": "node scripts/sync-plugin-version.mjs",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version"
  }
}
